{
  "name": "whalequest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5183 --strictPort",
    "build": "vite build && vite build --config vite.extension.config.ts && node scripts/package-extension.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5183 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:whale": "node scripts/verify-whale.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0", "lucide-react": "1.49.0" },
  "devDependencies": { "typescript": "6.0.3", "vite": "8.3.1", "@vitejs/plugin-react": "6.1.1", "vitest": "5.0.3", "@playwright/test": "1.63.0", "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@types/node": "26.6.3", "eslint": "10.11.0", "@eslint/js": "10.0.1", "typescript-eslint": "8.71.0", "globals": "17.12.0" }
}
