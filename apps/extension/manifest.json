{
  "manifest_version": 3,
  "name": "웨일 퀘스트",
  "description": "웨일 서비스 상황 인식 사이드바와 형성평가·협동 레이드·개인 복습 시연 도구",
  "version": "0.1.0",
  "permissions": [
    "storage"
  ],
  "sidebar_action": {
    "default_page": "sidebar.html",
    "default_title": "웨일 퀘스트",
    "default_icon": {
      "16": "icons/icon16.png"
    },
    "use_navigation_bar": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "host_permissions": [
    "https://ubt.whalespace.io/*",
    "https://class.whalespace.io/*",
    "https://teamboard.whalespace.io/*",
    "https://teamboard.whale.naver.com/*",
    "https://study.whaleon.naver.com/*"
  ]
}